# Porta local onde o servidor escuta (o nginx faz proxy de https://mcp.mpr.pt para aqui)
PORT=4200
MCP_HOST=127.0.0.1

# URL pública deste servidor — usada para os metadados OAuth e como issuer/audience dos tokens.
MCP_SERVER_URL=https://mcp.mpr.pt

# Credenciais do único utilizador (tu). É o que preenches no formulário de login quando o
# claude.ai pede para autorizar o conector.
MCP_OWNER_EMAIL=coloca_aqui_o_teu_email
MCP_OWNER_PASSWORD=coloca_aqui_uma_palavra_passe_forte

# API do primavera-importer de onde as ferramentas primavera_* leem/escrevem dados.
PRIMAVERA_API_BASE_URL=https://pri.mpr.pt/api/primavera

[Unit]
Description=ERP Evolution Importer Central API (pri.mpr.pt)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/programas/primavera-importer/api
EnvironmentFile=/home/ubuntu/programas/primavera-importer/api/.env
ExecStart=/usr/bin/node /home/ubuntu/programas/primavera-importer/api/server.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
